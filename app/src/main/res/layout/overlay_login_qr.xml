<?xml version="1.0" encoding="utf-8"?>
<!-- 扫码登录：用可见 WebView 直接打开抖音官方登录页，电视上显示官方二维码，
     手机抖音扫一下即可登录(不再需要在手机上复制粘贴 Cookie)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginQrOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6141418"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="抖音扫码登录"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/loginQrStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载官方登录页…"
            android:textColor="#FFD54F"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="按返回键取消"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <WebView
        android:id="@+id/loginQrWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
