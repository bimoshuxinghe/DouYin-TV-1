<?xml version="1.0" encoding="utf-8"?>
<!-- 官方扫码登录(API 版)：直接调用 login.douyin.com 的二维码接口，
     手机抖音扫一下 + 手机上确认，电视端自动拿到登录 Cookie。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qrApiOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_menu_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="抖音扫码登录"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/qrApiImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/qrApiStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="正在获取登录二维码…"
            android:textColor="#FFD54F"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="打开抖音 App → 左上角扫一扫 → 扫码后在手机上点“确认登录”"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="按返回键取消"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
